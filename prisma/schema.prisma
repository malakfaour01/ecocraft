generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String?
  ecoPoints   Int          @default(0)
  onboarded     Boolean       @default(false)
  interests     String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  crafts      Craft[]
  posts       Post[]
  savedCrafts SavedCraft[]
  recycleLogs RecycleLog[]
  listings    MarketplaceListing[]   
  challengeSubs ChallengeSubmission[] 
  followers     Follow[] @relation("Following")
  following     Follow[] @relation("Follower")
  currentStreak Int       @default(0)
  lastActiveDate DateTime?

}

model Item {
  id          String       @id @default(uuid())
  name        String
  category    String
  description String?
  createdAt   DateTime     @default(now())
  recycleLogs RecycleLog[]
}

model Material {
  id             String          @id @default(uuid())
  name           String          @unique
  category       String
  createdAt      DateTime        @default(now())
  craftMaterials CraftMaterial[]
}

model Craft {
  id             String          @id @default(uuid())
  title          String
  description    String
  difficulty     String          @default("beginner")
  estimatedTime  Int             @default(30)
  steps          String[]
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())
  craftMaterials CraftMaterial[]
  posts          Post[]
  savedBy        SavedCraft[]
   challengeSubs ChallengeSubmission[] 
   collectionLinks CollectionCraft[] 
}

model CraftMaterial {
  craftId    String
  materialId String
  craft      Craft    @relation(fields: [craftId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])

  @@id([craftId, materialId])
}

model Post {
  id        String   @id @default(uuid())
  imageUrl  String
  caption   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  craftId   String
  craft     Craft    @relation(fields: [craftId], references: [id])
  createdAt DateTime @default(now())
}

model SavedCraft {
  userId    String
  craftId   String
  user      User     @relation(fields: [userId], references: [id])
  craft     Craft    @relation(fields: [craftId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, craftId])
}

model RecycleLog {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  user      User     @relation(fields: [userId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())
}
model MarketplaceListing {
  id          String   @id @default(uuid())
  title       String
  description String?
  quantity    Int      @default(1)
  status      String   @default("available") // available | claimed
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}
model Challenge {
  id          String                @id @default(uuid())
  title       String
  description String
  isOfficial  Boolean               @default(false)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime              @default(now())
  submissions ChallengeSubmission[]
}

model ChallengeSubmission {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  craftId     String
  craft       Craft     @relation(fields: [craftId], references: [id])
  createdAt   DateTime  @default(now())
}
model RecyclingCenter {
  id                String   @id @default(uuid())
  name              String
  address           String
  acceptedMaterials String[]
  createdAt         DateTime @default(now())
}
model Collection {
  id          String            @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime          @default(now())
  crafts      CollectionCraft[]
}

model CollectionCraft {
  collectionId String
  craftId      String
  collection   Collection @relation(fields: [collectionId], references: [id])
  craft        Craft      @relation(fields: [craftId], references: [id])

  @@id([collectionId, craftId])
}
model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Follower", fields: [followerId], references: [id])
  following   User   @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}